/* ===== Chung ===== */
QWidget {
    font-family: "Inter", "Segoe UI", "Arial";
    font-size: 14px;
}

/* Default colors for pages created in C++.
   The shell uses a light content background, so inherited white text is unreadable. */
QLabel { color: #112D55; background: transparent; }
QGroupBox { color: #112D55; background: #FFFFFF; border: 1px solid #DDE3EC; border-radius: 12px; margin-top: 12px; padding: 18px 12px 12px 12px; }
QGroupBox::title { color: #112D55; subcontrol-origin: margin; left: 14px; padding: 0 5px; font-weight: 700; }
QTableWidget { color: #112D55; background: #FFFFFF; alternate-background-color: #F3F5F9; gridline-color: #DDE3EC; }
QHeaderView::section { color: #FFFFFF; background: #1B4F96; padding: 7px; border: none; font-weight: 600; }
QComboBox, QSpinBox, QTimeEdit, QDateEdit { color: #112D55; background: #FFFFFF; border: 1px solid #DDE3EC; border-radius: 8px; padding: 7px; }
QPushButton { color: #FFFFFF; background: #1B4F96; border: none; border-radius: 8px; padding: 9px 14px; }
QPushButton:hover { background: #163F7A; }
QCalendarWidget { color: #112D55; background: #FFFFFF; }
QCalendarWidget QToolButton { color: #112D55; background: #FFFFFF; padding: 6px; }
QCalendarWidget QMenu { color: #112D55; background: #FFFFFF; }
QCalendarWidget QSpinBox { color: #112D55; background: #FFFFFF; }
QCalendarWidget QAbstractItemView:enabled { color: #112D55; background: #FFFFFF; selection-background-color: #1B4F96; selection-color: #FFFFFF; }
QLabel#calendarDayTitle { color: #112D55; font-size: 17px; font-weight: 700; margin-top: 8px; }
QLabel#calendarEvent { color: #112D55; background: #E6EEF9; border-left: 4px solid #1B4F96; border-radius: 6px; padding: 10px; }

/* ===== LOGIN: panel trai ===== */
QFrame#leftPanel { background: #112D55; }

QLabel#lblLogo     { color: #FFFFFF; font-size: 46px; font-weight: 800; }
QFrame#logoBar     { background: #C8383F; border: none; }
QLabel#lblLogoApp  { color: #FFFFFF; font-size: 15px; font-weight: 700; }
QLabel#lblLogoSub  { color: #B9C6DC; font-size: 15px; }

QLabel#lblUniversity {
    color: #A8B8D2; font-size: 13px; font-weight: 500;
    margin-top: 64px;
}
QLabel#lblHeadline {
    color: #FFFFFF; font-size: 38px; font-weight: 800;
    margin-top: 28px; margin-bottom: 28px;
}
QFrame#redBar { background: #C8383F; border: none; }
QLabel#lblDescription {
    color: #A8B8D2; font-size: 17px;
    margin-top: 28px; margin-bottom: 40px;
}
QFrame#infoBox { background: #234875; border-radius: 14px; }
QLabel#lblInfoTitle { color: #FFFFFF; font-size: 16px; font-weight: 700; }
QLabel#lblInfoText  { color: #B9C6DC; font-size: 14px; }
QLabel#lblSemester  { color: #8FA2C0; font-size: 12px; }

/* ===== LOGIN: panel phai ===== */
QFrame#rightPanel { background: #F3F5F9; }

QLabel#lblWelcome    { color: #1B4F96; font-size: 13px; font-weight: 700; }
QLabel#lblHeading    { color: #112D55; font-size: 32px; font-weight: 800; margin-top: 8px; }
QLabel#lblSubheading { color: #66758C; font-size: 15px; margin-top: 8px; margin-bottom: 28px; }

QFrame#card {
    background: #FFFFFF;
    border: 1px solid #DDE3EC;
    border-radius: 16px;
}
QLabel#lblAccount, QLabel#lblPassword {
    color: #112D55; font-size: 14px; font-weight: 600;
    border: none; background: transparent;
}
QLabel#lblPassword { margin-top: 14px; }

QLineEdit {
    background: #FFFFFF;
    color: #112D55;
    border: 1px solid #DDE3EC;
    border-radius: 10px;
    padding: 12px 14px;
    font-size: 15px;
    min-height: 22px;
    placeholder-text-color: #4B5A70;
}
QLineEdit:focus { border: 1px solid #1B4F96; }

QPushButton#btnSignIn {
    background: #1B4F96; color: #FFFFFF;
    border: none; border-radius: 10px;
    padding: 14px 24px;
    font-size: 15px; font-weight: 600;
    margin-top: 16px; margin-bottom: 16px;
}
QPushButton#btnSignIn:hover   { background: #163F7A; }
QPushButton#btnSignIn:pressed { background: #123566; }
QPushButton#btnSignIn:disabled { background: #9DB3D3; }

QFrame#divider { background: #E5E9F0; border: none; }
QLabel#lblNoAccount {
    color: #66758C; font-size: 13px;
    border: none; background: transparent;
    margin-top: 14px;
}

QFrame#errorBanner { background: #FBEDEE; border-radius: 10px; margin-top: 24px; }
QLabel#lblErrorText { color: #C0272D; font-size: 14px; background: transparent; }
QLabel#lblErrorIcon { background: transparent; }

QLabel#lblHelp { color: #66758C; font-size: 13px; margin-top: 24px; }

/* ===== APP SHELL (sidebar + top bar) ===== */
QWidget#AppShell { background: #F3F5F9; }

QFrame#sidebar { background: #112D55; }
QLabel#sbLogo    { color: #FFFFFF; font-size: 30px; font-weight: 800; }
QFrame#sbLogoBar { background: #C8383F; border: none; }
QLabel#sbAppName { color: #FFFFFF; font-size: 12px; font-weight: 700; }
QLabel#sbAppSub  { color: #B9C6DC; font-size: 12px; }
QLabel#sbPortal  { color: #A8B8D2; font-size: 11px; margin-top: 28px; margin-bottom: 10px; }

QPushButton#navButton {
    color: #D6DFEE; background: transparent; border: none;
    border-radius: 10px; padding: 12px 14px; text-align: left; font-size: 14px;
}
QPushButton#navButton:hover   { background: #1B3A66; }
QPushButton#navButton:checked { background: #234875; color: #FFFFFF; font-weight: 600; }

QFrame#termBox { background: #14315C; border: 1px solid #2A4A78; border-radius: 12px; }
QLabel#termCaption { color: #A8B8D2; font-size: 12px; background: transparent; }
QLabel#termValue   { color: #FFFFFF; font-size: 14px; font-weight: 700; background: transparent; }
QLabel#sbFoot      { color: #A8B8D2; font-size: 12px; }

QFrame#topBar { background: #FFFFFF; border-bottom: 1px solid #E5E9F0; }
QLabel#breadcrumb { color: #66758C; font-size: 13px; }
QLabel#userName   { color: #112D55; font-size: 14px; font-weight: 700; }

QLabel#userRoleBadge {
    color: #1E40AF;
    background: #EFF6FF;
    border: 1px solid #DBEAFE;
    font-size: 10px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 4px;
}

QPushButton#linkPrimary {
    color: #1B4F96;
    background: transparent;
    font-size: 12px;
    font-weight: 500;
    border: none;
    padding: 2px 6px;
    border-radius: 4px;
}
QPushButton#linkPrimary:hover {
    background: #EFF6FF;
    color: #1E40AF;
    text-decoration: underline;
}

QPushButton#btnTopSignOut {
    color: #DC2626;
    background: #FEF2F2;
    border: 1px solid #FECACA;
    font-size: 11px;
    font-weight: 600;
    padding: 3px 12px;
    border-radius: 6px;
}
QPushButton#btnTopSignOut:hover {
    background: #DC2626;
    color: #FFFFFF;
    border: 1px solid #DC2626;
}

QPushButton#linkMuted {
    color: #64748B;
    background: transparent;
    font-size: 12px;
    border: none;
    padding: 2px 6px;
    border-radius: 4px;
}
QPushButton#linkMuted:hover {
    color: #112D55;
    background: #F1F5F9;
}

QLabel#avatar {
    background: #1B4F96;
    color: #FFFFFF;
    font-weight: 700;
    font-size: 13px;
    border-radius: 19px;
}

QScrollArea#pageScroll,
QScrollArea#pageScroll > QWidget > QWidget { background: #F3F5F9; }

QFrame#shellFooter { background: #F3F5F9; }
QLabel#footText    { color: #66758C; font-size: 12px; }

/* Dialogs & QMessageBox Styling */
QDialog {
    background-color: #FFFFFF;
    color: #112D55;
}

QMessageBox {
    background-color: #FFFFFF;
    color: #112D55;
}

QMessageBox QLabel {
    color: #112D55;
    background-color: transparent;
    font-size: 13px;
    font-weight: 500;
}

QMessageBox QPushButton {
    background-color: #1B4F96;
    color: #FFFFFF;
    font-weight: bold;
    border-radius: 6px;
    padding: 6px 24px;
    min-width: 70px;
    border: none;
}

QMessageBox QPushButton:hover {
    background-color: #163F7A;
}

/* ===== MINI CALENDAR (Bản nhỏ - Overview) ===== */
QWidget#miniCalendarCard {
    background-color: #FFFFFF;
    border: 1px solid #DDE3EC;
    border-radius: 16px;
}

QLabel#miniCalTitle {
    color: #1B4F96;
    font-size: 16px;
    font-weight: 700;
}

QPushButton#miniCalNavBtn {
    background-color: transparent;
    color: #475569;
    font-size: 15px;
    font-weight: 700;
    border: none;
    border-radius: 6px;
    padding: 0;
}
QPushButton#miniCalNavBtn:hover {
    background-color: #EFF6FF;
    color: #1B4F96;
}

QLabel#miniCalMonthBadge {
    color: #334155;
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 13px;
    font-weight: 600;
}

QLabel#miniCalColHeaderSun {
    color: #EA580C;
    font-size: 13px;
    font-weight: 700;
    padding: 4px 0;
}

QLabel#miniCalColHeader {
    color: #374151;
    font-size: 13px;
    font-weight: 700;
    padding: 4px 0;
}

QFrame#miniCalDivider {
    color: #E2E8F0;
    background-color: #E2E8F0;
    max-height: 1px;
}

/* ===== CARDS & WIDGETS IN OVERVIEW ===== */
QFrame#overviewCard {
    background-color: #FFFFFF;
    border: 1px solid #DDE3EC;
    border-radius: 16px;
    padding: 16px;
}

QLabel#overviewCardTitle {
    color: #112D55;
    font-size: 17px;
    font-weight: 700;
}

QLabel#overviewCardSubtitle {
    color: #64748B;
    font-size: 13px;
}

QFrame#scheduleItemCard {
    background-color: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-left: 4px solid #1B4F96;
    border-radius: 8px;
    padding: 10px 14px;
}

QFrame#scheduleItemCard:hover {
    background-color: #F1F5F9;
}

/* ===== KPI STAT CARDS (GUI 2.0) ===== */
QFrame#kpiCard {
    background-color: #FFFFFF;
    border: 1px solid #DDE3EC;
    border-radius: 14px;
    padding: 16px 20px;
}
QFrame#kpiCard:hover {
    border-color: #CBD5E1;
    background-color: #FAFCFF;
}

QLabel#kpiTitle {
    color: #64748B;
    font-size: 13px;
    font-weight: 600;
}

QLabel#kpiValue {
    color: #112D55;
    font-size: 26px;
    font-weight: 800;
}

QLabel#kpiSubtext {
    color: #64748B;
    font-size: 12px;
}

/* ===== BUTTON OUTLINE & COMBOS ===== */
QPushButton#btnOutline {
    background-color: #FFFFFF;
    color: #1B4F96;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 6px 14px;
    font-size: 13px;
    font-weight: 600;
}
QPushButton#btnOutline:hover {
    background-color: #EFF6FF;
    border-color: #1B4F96;
}

QComboBox#courseSelectCombo {
    background-color: #FFFFFF;
    color: #112D55;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    padding: 6px 14px;
    font-size: 13px;
    font-weight: 600;
    min-height: 24px;
}
QComboBox#courseSelectCombo:focus {
    border: 1px solid #1B4F96;
}
QComboBox#courseSelectCombo QAbstractItemView {
    background-color: #FFFFFF;
    color: #112D55;
    border: 1px solid #CBD5E1;
    selection-background-color: #EFF6FF;
    selection-color: #1B4F96;
    padding: 4px;
}

/* ===== HISTORY TABLE & BADGES ===== */
QTableWidget#historyTable {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    gridline-color: #F1F5F9;
    font-size: 13px;
    selection-background-color: #EFF6FF;
    selection-color: #112D55;
}
QTableWidget#historyTable QHeaderView::section {
    background-color: #F8FAFC;
    color: #475569;
    font-weight: 700;
    font-size: 12px;
    border: none;
    border-bottom: 1px solid #E2E8F0;
    padding: 8px 12px;
}
QTableWidget#historyTable::item {
    border-bottom: 1px solid #F1F5F9;
    padding: 6px 10px;
}

QLabel#badgePresent {
    background-color: #DCFCE7;
    color: #15803D;
    font-weight: 700;
    font-size: 11px;
    border-radius: 10px;
    padding: 3px 10px;
}

QLabel#badgeLate {
    background-color: #FEF3C7;
    color: #B45309;
    font-weight: 700;
    font-size: 11px;
    border-radius: 10px;
    padding: 3px 10px;
}

QLabel#badgeAbsent {
    background-color: #FEE2E2;
    color: #B91C1C;
    font-weight: 700;
    font-size: 11px;
    border-radius: 10px;
    padding: 3px 10px;
}

QLabel#badgeExcused {
    background-color: #DBEAFE;
    color: #1D4ED8;
    font-weight: 700;
    font-size: 11px;
    border-radius: 10px;
    padding: 3px 10px;
}

QLabel#badgeOpen {
    background-color: #E0F2FE;
    color: #0369A1;
    font-weight: 700;
    font-size: 11px;
    border-radius: 10px;
    padding: 3px 10px;
}

QLabel#badgeActive {
    background-color: #DCFCE7;
    color: #15803D;
    font-weight: 700;
    font-size: 11px;
    border-radius: 10px;
    padding: 3px 10px;
}

QLabel#badgeInactive {
    background-color: #F1F5F9;
    color: #64748B;
    font-weight: 700;
    font-size: 11px;
    border-radius: 10px;
    padding: 3px 10px;
}

/* ===== LIVE SESSION CODE DISPLAY ===== */
QFrame#liveCodeBox {
    background-color: #EFF6FF;
    border: 2px dashed #1B4F96;
    border-radius: 16px;
    padding: 24px;
}
QLabel#liveCodeNumber {
    color: #112D55;
    font-size: 54px;
    font-weight: 900;
    letter-spacing: 12px;
}
QLabel#liveCodeHint {
    color: #0369A1;
    font-size: 13px;
    font-weight: 600;
}

/* ===== PRESET BUTTONS ===== */
QPushButton#btnPreset {
    background-color: #F8FAFC;
    color: #1E293B;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 600;
}
QPushButton#btnPreset:hover {
    background-color: #EFF6FF;
    border-color: #1B4F96;
    color: #1B4F96;
}
QPushButton#btnPresetActive {
    background-color: #1B4F96;
    color: #FFFFFF;
    border: 1px solid #1B4F96;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#btnSubmitCheckIn {
    background-color: #1B4F96;
    color: #FFFFFF;
    font-weight: 700;
    font-size: 13px;
    padding: 8px 18px;
    border: none;
    border-radius: 6px;
}
QPushButton#btnSubmitCheckIn:hover {
    background-color: #163F7A;
}
QPushButton#btnSubmitCheckIn:disabled {
    background-color: #94A3B8;
    color: #F8FAFC;
}

QPushButton#btnDanger {
    background-color: #EF4444;
    color: #FFFFFF;
    font-weight: 600;
    font-size: 13px;
    padding: 8px 16px;
    border: none;
    border-radius: 6px;
}
QPushButton#btnDanger:hover {
    background-color: #DC2626;
}
QPushButton#btnDangerOutline {
    background-color: transparent;
    color: #DC2626;
    border: 1px solid #FECACA;
    border-radius: 6px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 600;
}
QPushButton#btnDangerOutline:hover {
    background-color: #FEF2F2;
    border-color: #DC2626;
}

QPushButton#btnPrimary {
    background-color: #1B4F96;
    color: #FFFFFF;
    font-weight: 700;
    font-size: 13px;
    padding: 8px 18px;
    border: none;
    border-radius: 6px;
    margin: 0px;
}
QPushButton#btnPrimary:hover {
    background-color: #163F7A;
}
QPushButton#btnPrimary:pressed {
    background-color: #123566;
}
QPushButton#btnPrimary:disabled {
    background-color: #94A3B8;
    color: #F8FAFC;
}

/* Global QComboBox Dropdown Styling */
QComboBox {
    color: #112D55;
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 13px;
    font-weight: 500;
}
QComboBox:focus {
    border: 1px solid #1B4F96;
}
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #112D55;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    selection-background-color: #EFF6FF;
    selection-color: #1B4F96;
    padding: 4px;
    outline: none;
}
QComboBox QAbstractItemView::item {
    min-height: 32px;
    padding: 6px 12px;
    color: #112D55;
    background-color: #FFFFFF;
}
QComboBox QAbstractItemView::item:hover {
    background-color: #F1F5F9;
    color: #1B4F96;
}
QComboBox QAbstractItemView::item:selected {
    background-color: #EFF6FF;
    color: #1B4F96;
    font-weight: 600;
}



